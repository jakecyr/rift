# Decision layer. Either name works. The TypeSafe SDK's own name is TYPESAFE_API_KEY.
TYPESAFE_API_KEY=
JEV_API_KEY=

# Generation provider. Set the key for the provider you pass to --provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROK_API_KEY=

# Optional.
OLLAMA_HOST=http://127.0.0.1:11434
OPENAI_BASE_URL=
